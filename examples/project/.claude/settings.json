{
  "extraKnownMarketplaces": {
    "agent-hub": {
      "source": {"source": "github", "repo": "leniva-ab/agent-hub", "ref": "v0.1.0"}
    }
  },
  "enabledPlugins": {
    "team-standard@agent-hub": true,
    "agent-review@agent-hub": true,
    "integration-jira@agent-hub": true,
    "integration-github@agent-hub": true,
    "integration-commits@agent-hub": true
  },
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5"
  }
}
