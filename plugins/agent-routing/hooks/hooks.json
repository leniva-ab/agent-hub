{
  "description": "Deny subagent spawns that would inherit the session model",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/agent_route.py", "hook"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
